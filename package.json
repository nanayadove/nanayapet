{
  "name": "netpet",
  "version": "1.4.0",
  "description": "桌面LLM虚拟宠物 - Electron版",
  "main": "main.js",
  "scripts": {
    "start": ".\\node_modules\\electron\\dist\\electron.exe .",
    "dev": ".\\node_modules\\electron\\dist\\electron.exe . --dev",
    "build": "electron-builder",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.netpet.app",
    "productName": "NetPet",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "config.example.json",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": null,
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nanayadove/nanayapet.git"
  },
  "keywords": [
    "desktop-pet",
    "electron",
    "llm"
  ],
  "author": "nanayadove",
  "license": "ISC",
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.65",
    "ai": "^6.0.191",
    "openai": "^6.38.0",
    "sql.js": "^1.14.1",
    "zod": "^4.4.3"
  }
}
